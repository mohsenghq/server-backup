# Copy to `.env` and edit. `docker compose` reads it automatically.

# REQUIRED. Wraps the catalog master key. Losing it makes the catalog (and the
# host keys inside it) unrecoverable. Keep it out of version control.
AEGIS_PASSPHRASE=

# Host interface/port the UI+API are published on.
AEGIS_BIND=127.0.0.1
# AEGIS_PORT=8080

# Concurrent backup workers in the job pool.
AEGIS_CONCURRENCY=4

# Password auth fallback for hosts registered without a dedicated SSH key.
# Leave empty to use per-host keys only (recommended).
AEGIS_SSH_PASSWORD=

# Job-completion notifications (optional, both off when unset).
AEGIS_WEBHOOK_URL=
AEGIS_TELEGRAM_BOT_TOKEN=
AEGIS_TELEGRAM_CHAT_ID=

RUST_LOG=aegis_server=info,aegis_core=info
